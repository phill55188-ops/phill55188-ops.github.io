{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "repository": {
          "const": "phill55188-ops/phill55188-ops.github.io"
        },
        "branch": {
          "const": "macro-backtest-v08"
        },
        "code_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workflow_path": {
          "type": "string",
          "minLength": 1
        },
        "workflow_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow_run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "test_type": {
          "enum": [
            "COMMON_WINDOW_ARCHITECTURE",
            "ANCHOR_FORWARD_THESIS",
            "EVENT_DATED_SYSTEM"
          ]
        },
        "information_set": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "branch",
        "code_commit",
        "workflow_path",
        "workflow_run_id",
        "workflow_run_attempt",
        "test_type",
        "information_set"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "historical_manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "config",
        "data",
        "historical_manifest"
      ],
      "additionalProperties": false
    },
    "status": {
      "const": "completed"
    },
    "conclusion": {
      "const": "success"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "git_file",
            "actions_artifact"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "result_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "id",
        "result_commit",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "receipt_source": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "identity",
    "inputs",
    "status",
    "conclusion",
    "artifact",
    "receipt_source",
    "verified_at"
  ],
  "additionalProperties": false,
  "$id": "urn:vera:macro-backtest:receipt:1.4"
}
